---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site.js';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
const { title, description = '', path = Astro.url.pathname, noindex = false, jsonLd = [], ogImage = 'https://images.unsplash.com/photo-1555990793-da11153b2473?auto=format&fit=crop&w=1200&q=75', darkNav = false, lcpImage = null } = Astro.props;
const canonical = SITE + (path === '/' ? '/' : path.replace(/\/$/, ''));
const ld = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
// Pages that pass no structured data get a plain WebPage + BreadcrumbList (SEO 31 Oct 2026).
if (!ld.filter(Boolean).length && !noindex && path !== '/404') {
  const name = String(title).replace(/\s*\|\s*PortTrip\s*$/, '');
  const crumbs = [{ name: 'Home', url: SITE + '/' }];
  const parent = canonical.replace(SITE, '').split('/').filter(Boolean);
  if (parent.length > 1 && (parent[0] === 'blog' || parent[0] === 'ports')) crumbs.push({ name: parent[0] === 'blog' ? 'Blog' : 'Ports', url: SITE + '/' + parent[0] });
  if (canonical !== SITE + '/') crumbs.push({ name, url: canonical });
  ld.push({ '@context': 'https://schema.org', '@type': 'WebPage', name, description, url: canonical, inLanguage: 'en-GB', isPartOf: { '@type': 'WebSite', name: 'PortTrip', url: SITE + '/' }, publisher: { '@type': 'Organization', name: 'PortTrip', url: SITE + '/' } });
  if (crumbs.length > 1) ld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) });
}
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="impact-site-verification" value="21fa16c3-d410-429b-818e-f4ad2c845118" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PortTrip" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0F2E44" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />
  {lcpImage && <link rel="preload" as="image" imagesrcset={lcpImage.srcset} imagesizes="100vw" href={lcpImage.src} fetchpriority="high" />}
  {ld.filter(Boolean).map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body class="min-h-screen">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
  <Nav dark={darkNav} />
  <main id="main"><slot /></main>
  <Footer />
  <Analytics />
  <SpeedInsights />
  <script>import '../scripts/track.js';</script>
</body>
</html>
