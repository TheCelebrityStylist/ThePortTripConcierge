---
import Base from '../../layouts/Base.astro';
import { BY_SLUG } from '../../lib/blog.js';
import { CAT, portImage, wm, wmSet } from '../../lib/ports.js';
import { app, fixLinks, PRICES, buyUrl } from '../../lib/site.js';
import Offer from '../../components/Offer.astro';
import StickyBuy from '../../components/StickyBuy.astro';
import PUB from '../../data/published.json';
import TourStrip from '../../components/TourStrip.astro';

// best-mediterranean-cruise-ports is served from the corrected -diy file.
const SOURCE = { 'best-mediterranean-cruise-ports': 'best-mediterranean-cruise-ports-diy' };
export function getStaticPaths() { return PUB.blog.map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const p = BY_SLUG[SOURCE[slug] || slug];
if (!p) throw new Error(`No post for ${slug}`);
const path = `/blog/${slug}`;
const ports = (Array.isArray(p.relatedPorts) ? p.relatedPorts : []).filter((s) => CAT[s]);
const pub = new Set(PUB.blog);
const heroImg = (ports[0] && portImage(ports[0])?.src) || portImage('santorini')?.src || null;
// Put the tour strip just before the third section, so it sits in the reading flow, not at the end.
const html = fixLinks(p.html);
const cut = (() => { let i = -1; for (let n = 0; n < 3; n++) { i = html.indexOf('<h2', i + 1); if (i < 0) return -1; } return i; })();
const [htmlA, htmlB] = cut > 0 ? [html.slice(0, cut), html.slice(cut)] : [html, ''];
const city0 = ports[0] ? String(CAT[ports[0]].city).split(' (')[0] : '';
const post = (s) => BY_SLUG[SOURCE[s] || s];
const related = (Array.isArray(p.relatedPosts) ? p.relatedPosts : []).filter((s) => s !== slug && pub.has(s) && post(s)).slice(0, 4);
const date = (d) => { try { return new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); } catch { return d; } };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: p.description, datePublished: p.date, dateModified: p.updated || p.date, author: { '@type': 'Person', name: p.author || 'Elke' }, publisher: { '@type': 'Organization', name: 'PortTrip' }, mainEntityOfPage: `https://porttrip.com${path}`, image: heroImg },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://porttrip.com/blog' }, { '@type': 'ListItem', position: 2, name: p.title, item: `https://porttrip.com${path}` }] },
  p.faqs.length && { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={/PortTrip/.test(p.title) ? p.title : `${p.title} | PortTrip`} description={p.description || p.excerpt} path={path} jsonLd={jsonLd} ogImage={heroImg || undefined}>
  <header class="relative isolate overflow-hidden bg-navy text-white">
    {heroImg && <img src={/wikimedia/.test(heroImg) ? wm(heroImg, 1920) : heroImg} srcset={/wikimedia/.test(heroImg) ? wmSet(heroImg) : undefined} sizes="100vw" alt="" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy via-navy/60 to-navy/10"></div>
    <div class="mx-auto max-w-3xl px-5 pb-10 pt-16 sm:px-8 sm:pb-14 sm:pt-28">
      <nav aria-label="Breadcrumb" class="text-sm text-white/70"><a href="/blog" class="hover:underline">Guides</a></nav>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">{p.h1 || p.title}</h1>
      <p class="mt-4 text-sm text-white/75">By {p.author || 'Elke'} · Updated {date(p.updated || p.date)} · {p.readTime} min read</p>
      {ports.length > 0 && <p class="mt-4 flex flex-wrap gap-2">{ports.map((s) => <a href={`/ports/${s}`} class="rounded-full bg-white/15 px-3 py-1 text-sm font-medium backdrop-blur hover:bg-white/25">{CAT[s].city} guide</a>)}</p>}
    </div>
  </header>
  <article class="mx-auto max-w-3xl px-5 pb-28 pt-8 sm:px-8">
    {p.quick && <div class="rounded-2xl border-l-4 border-signal bg-fog p-5 text-lg leading-relaxed"><strong>Quick answer:</strong> <span set:html={fixLinks(p.quick)} /></div>}
    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] text-navy/75"><span>Sailing soon? {city0 ? `Get ${city0} and every other port` : 'Get every port'} of your cruise timed to your all-aboard.</span><a href={buyUrl('cruise_pass', `blog_top_${slug}`)} class="font-semibold text-sea underline underline-offset-4" rel="nofollow" data-buy="blog_top">Cruise Pass, {PRICES.pass} once</a></p>
    <div class="doc mt-8" set:html={htmlA} />
    {ports[0] && <TourStrip slug={ports[0]} />}
    {htmlB && <div class="doc" set:html={htmlB} />}
    <div class="mt-12"><Offer city={city0} slug={ports[0] || ''} src={`blog_${slug}`} /></div>
    {related.length > 0 && <section class="mt-12"><h2 class="text-xl font-semibold">Read next</h2><ul class="mt-4 grid gap-3 sm:grid-cols-2">{related.map((s) => <li><a href={`/blog/${s}`} class="card block p-4 font-semibold hover:ring-sea/50">{post(s).h1 || post(s).title}</a></li>)}</ul></section>}
  </article>
  <StickyBuy city={city0} slug={ports[0] || ''} src={`blog_sticky_${slug}`} />
</Base>
