---
import Base from '../../layouts/Base.astro';
import { BY_SLUG } from '../../lib/blog.js';
import { CAT, portImage } from '../../lib/ports.js';
import { app, fixLinks, PRICES } from '../../lib/site.js';
import PUB from '../../data/published.json';

// best-mediterranean-cruise-ports is served from the corrected -diy file.
const SOURCE = { 'best-mediterranean-cruise-ports': 'best-mediterranean-cruise-ports-diy' };
export function getStaticPaths() { return PUB.blog.map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const p = BY_SLUG[SOURCE[slug] || slug];
if (!p) throw new Error(`No post for ${slug}`);
const path = `/blog/${slug}`;
const ports = (Array.isArray(p.relatedPorts) ? p.relatedPorts : []).filter((s) => CAT[s]);
const pub = new Set(PUB.blog);
const heroImg = p.hero || (ports[0] && portImage(ports[0])?.src) || null;
const related = (Array.isArray(p.relatedPosts) ? p.relatedPosts : []).filter((s) => pub.has(s) && BY_SLUG[s]).slice(0, 4);
const date = (d) => { try { return new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); } catch { return d; } };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: p.description, datePublished: p.date, dateModified: p.updated || p.date, author: { '@type': 'Person', name: p.author || 'Elke' }, publisher: { '@type': 'Organization', name: 'PortTrip' }, mainEntityOfPage: `https://porttrip.com${path}`, image: p.hero },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://porttrip.com/blog' }, { '@type': 'ListItem', position: 2, name: p.title, item: `https://porttrip.com${path}` }] },
  p.faqs.length && { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={/PortTrip/.test(p.title) ? p.title : `${p.title} | PortTrip`} description={p.description || p.excerpt} path={path} jsonLd={jsonLd} ogImage={heroImg || undefined}>
  <header class="relative isolate overflow-hidden bg-navy text-white">
    {heroImg && <img src={heroImg} alt="" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy via-navy/60 to-navy/10"></div>
    <div class="mx-auto max-w-3xl px-5 pb-10 pt-16 sm:px-8 sm:pb-14 sm:pt-28">
      <nav aria-label="Breadcrumb" class="text-sm text-white/70"><a href="/blog" class="hover:underline">Guides</a></nav>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-sm text-white/75">By {p.author || 'Elke'} · Updated {date(p.updated || p.date)} · {p.readTime} min read</p>
      {ports.length > 0 && <p class="mt-4 flex flex-wrap gap-2">{ports.map((s) => <a href={`/ports/${s}`} class="rounded-full bg-white/15 px-3 py-1 text-sm font-medium backdrop-blur hover:bg-white/25">{CAT[s].city} guide</a>)}</p>}
    </div>
  </header>
  <article class="mx-auto max-w-3xl px-5 pb-28 pt-8 sm:px-8">
    {p.quick && <div class="rounded-2xl border-l-4 border-signal bg-fog p-5 text-lg leading-relaxed"><strong>Quick answer:</strong> <span set:html={fixLinks(p.quick)} /></div>}
    <div class="doc mt-8" set:html={fixLinks(p.html)} />
    <aside class="mt-12 rounded-2xl bg-navy p-6 text-white">
      <p class="text-xl font-semibold">{ports[0] ? `Time your ${CAT[ports[0]].city} day to your ship` : 'Time every port day to your ship'}</p>
      <p class="mt-2 text-white/75">Leave-by times for every part of town, in port time and ship time, with the queues counted. Free for one port.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={app(ports[0] ? `/day/${ports[0]}` : '/day/dubrovnik')} class="btn-signal h-11 text-sm" rel="nofollow">Plan {ports[0] ? CAT[ports[0]].city : 'a port'} free</a>
        <a href="/pricing" class="inline-flex h-11 items-center rounded-lg px-4 text-sm font-semibold text-white underline underline-offset-4">Cruise Pass {PRICES.pass}</a>
      </div>
    </aside>
    {related.length > 0 && <section class="mt-12"><h2 class="text-xl font-semibold">Read next</h2><ul class="mt-4 grid gap-3 sm:grid-cols-2">{related.map((s) => <li><a href={`/blog/${s}`} class="card block p-4 font-semibold hover:ring-sea/50">{BY_SLUG[s].title}</a></li>)}</ul></section>}
  </article>
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-navy/10 bg-white/95 p-3 backdrop-blur sm:hidden">
    <a href={app(ports[0] ? `/day/${ports[0]}` : '/day/dubrovnik')} class="btn-signal w-full" rel="nofollow">Plan {ports[0] ? CAT[ports[0]].city : 'a port'} free</a>
  </div>
</Base>
