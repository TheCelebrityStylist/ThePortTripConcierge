---
import Base from '../../layouts/Base.astro';
import LeaveBy from '../../components/LeaveBy.astro';
import { GUIDES, CAT, SLUGS, leaveRows, rulesFor, shipDay, scoreOf, portImage, ACCESS_LABEL } from '../../lib/ports.js';
import ModeIcon from '../../components/ModeIcon.astro';
import { fmt, toMin } from '../../lib/site.js';
import { app, PRICES } from '../../lib/site.js';
import { POSTS } from '../../lib/blog.js';
import PUB from '../../data/published.json';

export function getStaticPaths() { return SLUGS.map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const g = GUIDES[slug]; const c = CAT[slug] || {}; const sd = shipDay(slug);
const rows = leaveRows(slug);
const rules = rulesFor(slug);
const pubBlog = new Set(PUB.blog);
const related = POSTS.filter((p) => pubBlog.has(p.slug) && Array.isArray(p.relatedPorts) && p.relatedPorts.includes(slug)).slice(0, 6);
const region = c.region; const neighbours = Object.entries(CAT).filter(([s, p]) => p.region === region && s !== slug).slice(0, 8);
const path = `/ports/${slug}`;
const steps = g.dayPlan?.steps || [];
const cityShortName = String(g.city).split(' (')[0];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: g.seoTitle, description: g.seoDescription, author: { '@type': 'Person', name: 'Elke' }, publisher: { '@type': 'Organization', name: 'PortTrip' }, dateModified: '2026-10-26', mainEntityOfPage: `https://porttrip.com${path}` },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ports', item: 'https://porttrip.com/ports' }, { '@type': 'ListItem', position: 2, name: g.city, item: `https://porttrip.com${path}` }] },
  g.faqs?.length && { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: g.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const H2 = 'h-section';
const img = portImage(slug);
const AA = g.dayPlan?.allAboard || '17:30';
const centre = rows[0];
const leaveAt = centre ? fmt(toMin(AA) - centre.minutesBeforeAllAboard) : null;
const score = scoreOf(slug);
const risk = { low: 'Low', medium: 'Medium', high: 'High' }[sd.returnRisk] || null;
const riskTone = { low: 'bg-emerald-400/90', medium: 'bg-signal', high: 'bg-red-400' }[sd.returnRisk] || 'bg-white/40';
const JUMP = [['leave-by-m', 'When to leave'], ['transport', 'Getting there'], ['day-plan', 'Day plan'], ['sights', 'What to see'], ['food', 'Food'], ['mistakes', 'Mistakes'], ['faq', 'FAQ'], ['sources', 'Sources']];
---
<Base title={g.seoTitle?.includes('PortTrip') ? g.seoTitle : `${g.seoTitle} | PortTrip`} description={g.seoDescription} path={path} jsonLd={jsonLd}>
  <section class="relative isolate overflow-hidden bg-navy text-white">
    {img && <img src={img.src} alt={`${g.city}`} width={img.w} height={img.h} fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy via-navy/70 to-navy/20"></div>
    <div class="wrap pb-10 pt-16 sm:pb-14 sm:pt-28">
      <nav aria-label="Breadcrumb" class="text-sm text-white/70"><a href="/ports" class="hover:underline">Ports</a> <span aria-hidden="true">/</span> {region && <>{region} <span aria-hidden="true">/</span></>} {g.city}</nav>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">{g.city} cruise port</h1>
      {leaveAt && <p class="mt-5 max-w-2xl text-lg text-white/90 sm:text-xl">All aboard {AA}? Leave {centre.from} by <span class="rounded-md bg-signal px-2 py-0.5 font-semibold tabular-nums text-navy">{leaveAt}</span></p>}
      <ul class="mt-6 flex flex-wrap gap-2 text-sm">
        <li class="rounded-full bg-white/15 px-3 py-1.5 backdrop-blur">{g.isTender ? 'Tender port' : ACCESS_LABEL[c.sd?.access] || 'Docks alongside'}</li>
        {g.walkability?.minutes && <li class="rounded-full bg-white/15 px-3 py-1.5 backdrop-blur">{g.walkability.minutes} min walk to town</li>}
        {risk && <li class="flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 backdrop-blur"><span class:list={['h-2 w-2 rounded-full', riskTone]}></span>Return risk: {risk}</li>}
        <li class="rounded-full bg-white/15 px-3 py-1.5 backdrop-blur"><a href="/cruise-port-index" class="hover:underline">DIY score {score}/10</a></li>
        <li class="rounded-full bg-white/15 px-3 py-1.5 backdrop-blur">Checked {g.lastVerified} · {g.sources?.length || 0} sources</li>
      </ul>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={app(`/day/${slug}?aa=${encodeURIComponent(AA)}`)} class="btn-signal" rel="nofollow">Plan my {cityShortName} day free</a>
        <a href="#leave-by-m" class="inline-flex h-12 items-center rounded-lg bg-white/15 px-5 font-semibold ring-1 ring-white/30 backdrop-blur hover:bg-white/25 lg:hidden">Time it to my ship</a>
      </div>
      {img && <p class="mt-6 text-[11px] text-white/45">Photo: <a href={img.page} class="underline" rel="noopener nofollow">{img.artist || 'Wikimedia Commons'}</a>{img.license ? `, ${img.license}` : ''}</p>}
    </div>
  </section>
  <nav aria-label="On this page" class="sticky top-14 z-30 border-b border-navy/10 bg-white/95 backdrop-blur">
    <div class="wrap flex gap-1 overflow-x-auto py-2 text-sm [scrollbar-width:none]">
      {JUMP.map(([id, l]) => <a href={`#${id}`} class="whitespace-nowrap rounded-full px-3 py-1.5 text-navy/70 hover:bg-fog hover:text-navy">{l}</a>)}
    </div>
  </nav>
  <article class="wrap pb-24 pt-8 sm:pt-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
      <div class="min-w-0">
        <p class="rounded-2xl border-l-4 border-signal bg-fog p-5 text-lg leading-relaxed"><strong>Quick answer:</strong> {g.quickAnswer}</p>
        <p class="mt-6 text-lg leading-relaxed text-navy/85">{g.intro}</p>

        <div id="leave-by-m" class="mt-8 scroll-mt-28 lg:hidden"><LeaveBy slug={slug} city={g.city} rows={rows} defaultAA={g.dayPlan?.allAboard || '17:30'} isTender={g.isTender} /></div>

        <section id="getting-there" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Where the ship docks</h2>
          <ul class="mt-4 space-y-3">{(g.terminals || []).map((t) => <li class="card p-4"><p class="font-semibold">{t.name}{t.distanceToCentreKm != null && <span class="font-normal text-navy/60"> · {t.distanceToCentreKm} km to the centre</span>}</p>{t.notes && <p class="mt-1 text-navy/80">{t.notes}</p>}</li>)}</ul>
          {g.walkability?.detail && <p class="mt-4 text-navy/85"><strong>Can you walk?</strong> {g.walkability.verdict}{g.walkability.minutes ? `, about ${g.walkability.minutes} min` : ''}. {g.walkability.detail}</p>}
          {g.isTender && g.tenderNotes && <p class="mt-4 rounded-xl border-l-4 border-signal bg-mist p-4 text-navy/85"><strong>Tender:</strong> {g.tenderNotes}</p>}
        </section>

        <section id="transport" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Getting to town</h2>
          <div class="mt-4 space-y-3">{(g.transportSections || []).map((t) => (
            <div class="card flex gap-4 p-4"><ModeIcon mode={t.mode} /><div class="min-w-0 flex-1"><h3 class="font-semibold">{t.mode}</h3><p class="mt-1 flex flex-wrap gap-1.5 text-xs font-medium">{t.cost && <span class="rounded-full bg-fog px-2.5 py-1">{t.cost}</span>}{t.time && <span class="rounded-full bg-fog px-2.5 py-1">{t.time}</span>}</p>{t.detail && <p class="mt-2 text-navy/80">{t.detail}</p>}</div></div>
          ))}</div>
        </section>

        <section id="return" class="mt-12 scroll-mt-20">
          <h2 class={H2}>When to head back</h2>
          {g.returnTiming?.rule && <p class="mt-4 text-lg font-semibold">{g.returnTiming.rule}</p>}
          {g.returnTiming?.detail && <p class="mt-2 text-navy/85">{g.returnTiming.detail}</p>}
          {g.returnTiming?.emergencyFallback && <p class="mt-3 rounded-xl bg-mist p-4 text-navy/85"><strong>If you are running late:</strong> {g.returnTiming.emergencyFallback}</p>}
          {sd.topRisk && <p class="mt-3 text-navy/85"><strong>Where people go wrong:</strong> {sd.topRisk}</p>}
        </section>

        {steps.length > 0 && <section id="day-plan" class="mt-12 scroll-mt-20">
          <h2 class={H2}>A day in {g.city}</h2>
          {g.dayPlan.intro && <p class="mt-2 text-navy/70">{g.dayPlan.intro}</p>}
          <ol class="relative mt-6 space-y-5 before:absolute before:bottom-2 before:left-[1.65rem] before:top-2 before:w-0.5 before:bg-sea/25">{steps.map((st) => { const late = leaveAt && toMin(st.time) != null && toMin(st.time) >= toMin(leaveAt); return (<li class="relative flex gap-4"><span class:list={['relative z-10 grid h-8 w-14 flex-shrink-0 place-items-center rounded-full text-sm font-semibold tabular-nums', late ? 'bg-signal text-navy' : 'bg-navy text-white']}>{st.time}</span><span class="pt-1 text-navy/85">{st.what}</span></li>); })}</ol>
          <a href={app(`/day/${slug}?aa=${encodeURIComponent(g.dayPlan.allAboard || '17:30')}`)} class="mt-5 inline-block font-semibold text-sea underline underline-offset-4" rel="nofollow">Re-time this day to your ship</a>
        </section>}

        {g.sights?.length > 0 && <section id="sights" class="mt-12 scroll-mt-20">
          <h2 class={H2}>What to see</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">{g.sights.map((s) => <div class="card p-4"><h3 class="font-semibold">{s.name}</h3>{s.why && <p class="mt-1 text-navy/80">{s.why}</p>}<p class="mt-3 flex flex-wrap gap-1.5 text-xs font-medium">{s.timeNeeded && <span class="rounded-full bg-fog px-2.5 py-1">{s.timeNeeded}</span>}{s.cost && <span class="rounded-full bg-fog px-2.5 py-1">{s.cost}</span>}</p>{s.tip && <p class="mt-1 text-sm text-navy/70">{s.tip}</p>}</div>)}</div>
        </section>}

        {g.beaches?.length > 0 && <section id="beaches" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Beaches</h2>
          <div class="mt-4 space-y-3">{g.beaches.map((b) => <div class="card p-4"><h3 class="font-semibold">{b.name}</h3><p class="mt-1 text-navy/80">{[b.howToGetThere, b.time, b.cost].filter(Boolean).join(' · ')}</p>{b.note && <p class="mt-1 text-sm text-navy/70">{b.note}</p>}</div>)}</div>
        </section>}

        {g.food?.length > 0 && <section id="food" class="mt-12 scroll-mt-20">
          <h2 class={H2}>What to eat</h2>
          <ul class="mt-4 space-y-2">{g.food.map((f) => <li class="text-navy/85"><strong>{f.dish}</strong>{f.where && ` · ${f.where}`}{f.price && ` · ${f.price}`}</li>)}</ul>
        </section>}

        <section id="diy-vs-excursion" class="mt-12 scroll-mt-20">
          <h2 class={H2}>On your own or a ship excursion?</h2>
          {g.excursionAdvice && <p class="mt-4 text-navy/85">{g.excursionAdvice}</p>}
          {g.diyVsExcursion?.length > 0 && <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-sm">
            <thead><tr class="border-b border-navy/15 text-navy/60"><th class="py-2 pr-3 font-semibold">What</th><th class="py-2 pr-3 font-semibold">Ship</th><th class="py-2 pr-3 font-semibold">On your own</th><th class="py-2 font-semibold">Saving</th></tr></thead>
            <tbody>{g.diyVsExcursion.map((r) => <tr class="border-b border-navy/10 align-top"><td class="py-2.5 pr-3 font-semibold">{r.item}</td><td class="py-2.5 pr-3 text-navy/80">{r.ship}</td><td class="py-2.5 pr-3 text-navy/80">{r.diy}</td><td class="py-2.5 text-navy/80">{r.saving}</td></tr>)}</tbody>
          </table></div>}
        </section>

        {g.commonMistakes?.length > 0 && <section id="mistakes" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Common mistakes</h2>
          <ul class="mt-4 space-y-3">{g.commonMistakes.map((m) => <li class="card border-l-4 border-l-red-500 p-4"><p class="font-semibold">{m.mistake}</p>{m.fix && <p class="mt-1 text-navy/80">{m.fix}</p>}</li>)}</ul>
        </section>}

        <section id="safety" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Safety, access and bad weather</h2>
          <dl class="mt-4 space-y-4 text-navy/85">
            {g.safety && <div><dt class="font-semibold">Safety</dt><dd class="mt-1">{g.safety} Emergency number: {g.emergencyNumber}.</dd></div>}
            {g.scams?.length > 0 && <div><dt class="font-semibold">Scams to know</dt><dd class="mt-1"><ul class="list-disc space-y-1 pl-5">{g.scams.map((s) => <li>{s}</li>)}</ul></dd></div>}
            {g.accessibility && <div><dt class="font-semibold">Accessibility</dt><dd class="mt-1">{g.accessibility}</dd></div>}
            {g.rainyDay && <div><dt class="font-semibold">If it rains</dt><dd class="mt-1">{g.rainyDay}</dd></div>}
            {g.crowdTips && <div><dt class="font-semibold">Crowds</dt><dd class="mt-1">{g.crowdTips}</dd></div>}
          </dl>
        </section>

        {rules.length > 0 && <section id="rules" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Fees and rules for visitors</h2>
          <ul class="mt-4 space-y-3">{rules.map((r) => <li class="card p-4"><p class="font-semibold">{r.summary}</p>{r.amount && <p class="mt-1 text-navy/80">{r.amount}</p>}{r.effective && <p class="mt-1 text-sm text-navy/60">{r.effective}</p>}</li>)}</ul>
          <a href="/cruise-port-rules" class="mt-3 inline-block text-sm font-semibold text-sea underline underline-offset-4">All port fees and rules</a>
        </section>}

        {g.faqs?.length > 0 && <section id="faq" class="mt-12 scroll-mt-20">
          <h2 class={H2}>{g.city} cruise port FAQ</h2>
          <div class="mt-4 divide-y divide-navy/10 border-y border-navy/10">{g.faqs.map((f) => <details class="group"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden"><h3 class="font-semibold">{f.q}</h3><span class="text-xl text-sea group-open:rotate-45 transition-transform" aria-hidden="true">+</span></summary><p class="pb-4 text-navy/80">{f.a}</p></details>)}</div>
        </section>}

        {g.uncertain?.length > 0 && <section class="mt-10 rounded-2xl bg-mist p-5 text-sm text-navy/80">
          <h2 class="font-semibold text-navy">Not yet confirmed</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">{g.uncertain.map((u) => <li>{typeof u === 'string' ? u : (u.what || u.item || JSON.stringify(u))}</li>)}</ul>
        </section>}

        <section id="sources" class="mt-12 scroll-mt-20">
          <h2 class={H2}>Sources</h2>
          <p class="mt-2 text-sm text-navy/60">Checked {g.lastVerified}. Spotted something out of date? Email hello@porttrip.com.</p>
          <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-sm">{(g.sources || []).map((s) => <li><a href={s.url} class="text-sea underline underline-offset-2" rel="noopener nofollow">{s.title}</a></li>)}</ol>
        </section>

        {related.length > 0 && <section class="mt-12"><h2 class={H2}>Read next</h2><ul class="mt-4 grid gap-3 sm:grid-cols-2">{related.map((p) => <li><a href={`/blog/${p.slug}`} class="card block p-4 font-semibold hover:ring-sea/50">{p.title}</a></li>)}</ul></section>}
        {neighbours.length > 0 && <section class="mt-10"><h2 class="text-lg font-semibold">More ports in {region}</h2><p class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5">{neighbours.map(([s, p]) => <a href={`/ports/${s}`} class="text-sea underline-offset-4 hover:underline">{p.city}</a>)}</p></section>}
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-20 space-y-4">
          <LeaveBy slug={slug} city={g.city} rows={rows} defaultAA={g.dayPlan?.allAboard || '17:30'} isTender={g.isTender} />
          <div class="rounded-2xl bg-navy p-5 text-white">
            <p class="font-semibold">Your whole cruise, timed</p>
            <p class="mt-1 text-sm text-white/75">Every port on your sailing, in port and ship time, then live on the day with Google Maps and alerts.</p>
            <a href={app('/pricing')} class="btn-signal mt-4 h-11 w-full text-sm" rel="nofollow">Cruise Pass {PRICES.pass}</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-navy/10 bg-white/95 p-3 backdrop-blur lg:hidden">
    <a href={app(`/day/${slug}?aa=${encodeURIComponent(AA)}`)} class="btn-signal w-full" rel="nofollow">Plan my {cityShortName} day free</a>
  </div>
</Base>
