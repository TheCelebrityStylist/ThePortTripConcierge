---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | PortTrip" description="This page has moved or never existed." path="/404" noindex>
  <div class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">This page has sailed.</h1>
    <p class="mt-4 text-lg text-navy/75">It may have moved. Try your port or the guides.</p>
    <p class="mt-8 flex justify-center gap-3"><a href="/ports" class="btn-navy">All ports</a><a href="/blog" class="inline-flex h-12 items-center rounded-lg px-5 font-semibold text-sea underline underline-offset-4">Guides</a></p>
  </div>
</Base>
