---
import Base from '../layouts/Base.astro';
import { SLUGS, CAT, cityShort } from '../lib/ports.js';
import PUB from '../data/published.json';
// Every live path, so the page can rescue old addresses that differ only in capitals
// or that contain a port we have (e.g. /port/Athens -> /ports/athens).
const STATIC = ['/', '/ports', '/blog', '/pricing', '/about', '/methodology', '/cruise-port-index', '/cruise-port-rules', '/leave-by-widget', '/editorial-policy', '/corrections', '/privacy', '/legal/terms'];
const valid = [...new Set([...STATIC, ...SLUGS.map((s) => `/ports/${s}`), ...PUB.blog.map((s) => `/blog/${s}`), ...PUB.urls.map((u) => u.path)])];
const ports = SLUGS.map((s) => [s, `${cityShort(CAT[s]?.city || s)}, ${CAT[s]?.country || ''}`]).sort((a, b) => a[1].localeCompare(b[1]));
const popular = ['rome', 'barcelona', 'santorini', 'dubrovnik', 'naples', 'athens', 'kotor', 'livorno'].filter((s) => SLUGS.includes(s));
---
<Base title="Page not found | PortTrip" description="This page has moved or never existed." path="/404" noindex>
  <div class="mx-auto max-w-2xl px-5 py-20">
    <h1 class="text-4xl font-semibold tracking-tight">This page has sailed.</h1>
    <p id="nf-msg" class="mt-4 text-lg text-navy/75">The address may be old. Find your port below, or start from the guides.</p>
    <label for="nf-q" class="mt-8 block text-sm font-semibold">Which port?</label>
    <input id="nf-q" type="search" autocomplete="off" placeholder="e.g. Kotor, Barcelona, Santorini" class="mt-2 h-12 w-full rounded-xl border border-navy/20 bg-white px-4 text-base focus:border-sea focus:outline-none" />
    <ul id="nf-list" class="mt-3 divide-y divide-navy/10 rounded-xl border border-navy/10 bg-white" hidden></ul>
    <p class="mt-6 text-sm text-navy/60">Popular:
      {popular.map((s, i) => <>{i ? ' · ' : ' '}<a href={`/ports/${s}`} class="font-semibold text-sea underline-offset-4 hover:underline">{cityShort(CAT[s].city)}</a></>)}
    </p>
    <p class="mt-8 flex flex-wrap gap-3"><a href="/ports" class="btn-navy">All {SLUGS.length} ports</a><a href="/blog" class="inline-flex h-12 items-center rounded-lg px-5 font-semibold text-sea underline underline-offset-4">Guides</a></p>
  </div>
  <script is:inline define:vars={{ valid, ports }}>
    (function () {
      var VALID = new Set(valid);
      var SLUGSET = new Set(ports.map(function (p) { return p[0]; }));
      var path = location.pathname;
      var lower = (path.toLowerCase().replace(/\/+$/, '')) || '/';
      var target = '';
      if (lower !== path && VALID.has(lower)) target = lower;
      if (!target) {
        var segs = lower.split('/').filter(Boolean);
        for (var i = 0; i < segs.length; i++) { if (SLUGSET.has(segs[i])) { target = '/ports/' + segs[i]; break; } }
      }
      try {
        var body = JSON.stringify({ type: '404', path: path + location.search, ref: document.referrer || '', outcome: target ? 'redirected' : 'suggested', target: target });
        navigator.sendBeacon && navigator.sendBeacon('https://porttripapp.com/functions/siteBeacon', new Blob([body], { type: 'text/plain' }));
      } catch (e) { /* never block the visitor */ }
      if (target) { document.getElementById('nf-msg').textContent = 'This page moved. Taking you there…'; setTimeout(function () { location.replace(target + location.hash); }, 150); return; }
      var q = document.getElementById('nf-q'), list = document.getElementById('nf-list');
      var norm = function (s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
      q.addEventListener('input', function () {
        var t = norm(q.value.trim());
        list.innerHTML = '';
        if (t.length < 2) { list.hidden = true; return; }
        var hits = ports.filter(function (p) { return norm(p[1]).indexOf(t) !== -1 || p[0].indexOf(t) !== -1; }).slice(0, 8);
        hits.forEach(function (p) { var li = document.createElement('li'); var a = document.createElement('a'); a.href = '/ports/' + p[0]; a.textContent = p[1]; a.className = 'block px-4 py-3 font-semibold hover:bg-fog'; li.appendChild(a); list.appendChild(li); });
        if (!hits.length) { var li = document.createElement('li'); li.className = 'px-4 py-3 text-navy/60'; li.textContent = 'Not covered yet. See all ports.'; list.appendChild(li); }
        list.hidden = false;
      });
    })();
  </script>
</Base>
