---
const COLS = [
  ['Popular ports', [['/ports/rome', 'Rome (Civitavecchia)'], ['/ports/barcelona', 'Barcelona'], ['/ports/santorini', 'Santorini'], ['/ports/dubrovnik', 'Dubrovnik'], ['/ports/livorno', 'Florence (Livorno)'], ['/ports/naples', 'Naples'], ['/ports/kotor', 'Kotor'], ['/ports', 'All ports']]],
  ['Plan', [['/cruise-port-index', 'Cruise Port Index'], ['/cruise-port-rules', 'Port fees and rules 2026–27'], ['/can-a-cruise-ship-leave-without-you', 'Can the ship leave without you?'], ['/how-late-can-you-return-to-a-cruise-ship', 'How late can you get back on board?'], ['/blog', 'Guides and articles'], ['/leave-by-widget', 'Leave-by widget for your site'], ['https://porttripapp.com/travel-advisors', 'For travel advisors'], ['/pricing', 'Pricing']]],
  ['PortTrip', [['/about', 'About'], ['/what-is-porttrip', 'What is PortTrip'], ['/methodology', 'How we check ports'], ['/editorial-policy', 'Editorial policy'], ['/corrections', 'Corrections'], ['/privacy', 'Privacy'], ['/legal/terms', 'Terms']]],
];
---
<footer class="bg-navy px-5 pb-8 pt-14 text-white sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="text-lg font-semibold">PortTrip</a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/65">Port days timed to your all-aboard. Made in Maastricht. Spotted a mistake? <a href="mailto:hello@porttrip.com" class="text-white underline underline-offset-4">hello@porttrip.com</a></p>
      </div>
      {COLS.map(([h, links]) => (
        <nav aria-label={h}>
          <p class="text-sm font-semibold text-signal">{h}</p>
          <ul class="mt-3 space-y-2">{links.map(([to, l]) => <li><a href={to} class="text-sm text-white/75 underline-offset-4 hover:text-white hover:underline">{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="mt-12 border-t border-white/10 pt-6 text-xs text-white/50">© {new Date().getFullYear()} PortTrip</p>
  </div>
</footer>
