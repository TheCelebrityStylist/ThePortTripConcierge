---
// The Cruise Pass offer, placed where the reader has just felt the problem.
// Every claim is sourced in the post its "Why" link points to.
import { app, buyUrl, PRICES, PROOF } from '../lib/site.js';
const { city = '', slug = '', src = 'offer', freeHref = '', heading = '' } = Astro.props;
const h = heading || (city ? `${city} is one day. Time the whole cruise.` : 'Every port of your cruise, timed to your ship.');
const free = freeHref || (slug ? app(`/day/${slug}`) : app('/day/dubrovnik'));
---
<section class="not-prose overflow-hidden rounded-3xl bg-navy text-white shadow-[0_30px_60px_-30px_rgba(18,50,74,0.7)]" aria-label="Cruise Pass">
  <div class="grid gap-0 md:grid-cols-[1.35fr_1fr]">
    <div class="p-6 sm:p-8">
      <p class="font-display text-2xl font-semibold leading-tight sm:text-3xl">{h}</p>
      <ul class="mt-6 space-y-5">
        {PROOF.map((p) => (
          <li class="border-l-2 border-signal pl-4">
            <p class="font-semibold">{p.head}</p>
            <p class="mt-1 text-[15px] leading-relaxed text-white/75">{p.body} <a href={p.href} class="whitespace-nowrap text-white/90 underline underline-offset-2">The details</a></p>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col justify-center bg-white/[0.06] p-6 sm:p-8">
      <p class="text-sm font-semibold text-white/70">Cruise Pass</p>
      <p class="mt-1"><span class="font-display text-5xl font-semibold tracking-tight">{PRICES.pass}</span> <span class="text-white/70">once</span></p>
      <p class="mt-2 text-[15px] leading-relaxed text-white/80">Up to 10 ports of one sailing, timed to your all-aboard in port time and ship time. Live mode and alerts on the day. An offline copy for when the signal drops.</p>
      <a href={buyUrl('cruise_pass', src)} class="btn-signal mt-6 w-full text-base" rel="nofollow" data-buy={src}>Get the Cruise Pass</a>
      <p class="mt-3 text-center text-sm text-white/65">Pay once, nothing renews. 30-day full refund.</p>
      <a href={free} class="mt-4 text-center text-sm font-semibold text-white/85 underline underline-offset-4" rel="nofollow">Or plan {city || 'one port'} free first</a>
    </div>
  </div>
</section>
