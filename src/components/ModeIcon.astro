---
// Small line icons for transport modes, picked from the mode text.
const { mode = '' } = Astro.props;
const m = mode.toLowerCase();
const k = /cable|funicular|lift|elevator/.test(m) ? 'cable' : /train|rail|metro|tram|fl5|regional/.test(m) ? 'train' : /ferry|boat|tender|water/.test(m) ? 'boat' : /taxi|uber|bolt|car|ride/.test(m) ? 'taxi' : /bus|shuttle|coach/.test(m) ? 'bus' : /walk|foot/.test(m) ? 'walk' : 'pin';
const P = {
  walk: '<circle cx="13" cy="4" r="2"/><path d="M9 21l2-6 3 3v4M7 12l3-4 4 1 2 4M10 8l-1 5"/>',
  bus: '<rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 10h16M7 21v-4M17 21v-4"/><circle cx="8" cy="14" r="1"/><circle cx="16" cy="14" r="1"/>',
  train: '<rect x="5" y="3" width="14" height="13" rx="3"/><path d="M5 10h14M8 20l-2 2M16 20l2 2M8 16l-1 4M16 16l1 4"/>',
  taxi: '<path d="M5 17h14v-5l-2-5H7l-2 5z"/><path d="M3 12h18"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/>',
  boat: '<path d="M3 17l2 3h14l2-3H3zM12 3v11M12 4l6 9H12"/>',
  cable: '<path d="M3 4l18 4M12 6v4"/><rect x="7" y="10" width="10" height="9" rx="2"/><path d="M7 14h10"/>',
  pin: '<path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
---
<span class="grid h-10 w-10 flex-shrink-0 place-items-center rounded-xl bg-sea/10 text-sea" aria-hidden="true">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={P[k]} />
</span>
